# build output and caches (regenerated by build_exe.cmd / build-wsl.sh)
companion/build/
companion/dist/
__pycache__/
*.pyc
companion/.cache/
companion/pms.log
companion/pms.log.*
companion/installed.json
companion/config.json.unreadable-*
ps5-app/tile/_appdb_work/
ps5-app/tile/__pycache__/
ps5-app/tile-pkg/build/
# generated bundles (build-wsl.sh regenerates them from web/ and assets/cheats)
ps5-app/onconsole/web_bundle.h
ps4-app/onconsole/web_bundle.h
# PS4 dashboard app: everything the toolchain regenerates. The .pkg itself IS tracked - the exe
# bundles it, so a fresh clone must be able to build the companion without the PS4 toolchain.
ps4-app/tile-pkg/pms/x64/
ps4-app/tile-pkg/eboot.bin
ps4-app/tile-pkg/pkg.gp4
ps4-app/tile-pkg/pms-payload.elf
ps4-app/onconsole/PKG-MUTANT-SHOP-PS4-LITE.elf
ps4-app/tile-pkg/sce_sys/param.sfo
ps4-app/tile-pkg/sce_sys/about/
ps4-app/tile-pkg/sce_module/
# the PS4 test fixtures are generated by tools/ps4-itest/make_fixtures.py
tools/ps4-itest/app.db
tools/ps4-itest/addcont.db
ps5-app/onconsole/cheat_bundle.h
ps5-app/onconsole/cheats.pack

# PyInstaller outputs when run from the repo root
/dist/
/build/

# release/ is build output: tools/release.py rewrites manifest.json, SHA256SUMS and NOTES.md on
# every run and the artifacts it uploads are already tracked where they are built.
/release/

# The owner's GitHub token, if it is ever put in a file beside the repo rather than in config.json
# next to the exe. It is needed only while our own repository is private (see RELEASING.md) and it
# must never be committed.
.github_token

# THE OWNER'S LIVE CONFIG IS NOT SOURCE. It was tracked, which meant this machine's device id went
# into the history and - the moment RELEASING.md's `updates.github_token` was used - a token would
# have followed it. config.example.json is the template, start.cmd copies it, and the app falls back
# to DEFAULT_CONFIG when neither exists, so nothing needs this file to be in the repo.
# (Written as its own line: an earlier attempt checked for the substring "companion/config.json",
# which was ALREADY here as config.json.unreadable-*, so the rule was silently never added and
# `git add -A` put the file straight back.)
/companion/config.json

# OUR OWN NOTES ARE NOT THE PUBLIC'S. internal/ holds the documents that exist so WE can rebuild
# this thing: superseded design notes that still carry useful history, the install engine's outage
# runbook, the release workflow, roadmaps, and the research folder - which also held a partial copy
# of etaHEN's source, i.e. somebody else's GPL code that had no business in a public repository.
# Every byte is still on disk, exactly where it was, one directory deeper. Nothing here is secret;
# it is simply written for us, and a stranger reading "SUPERSEDED - what is no longer true" learns
# nothing except that our docs contradict each other.
/internal/

# Scratch written by tools/test_agent_protocol.py, which runs the agent wire protocol over a
# real file channel. It was tracked by accident, so every run of that test dirtied the tree and
# the release tool - correctly - refused to tag.
ps4-app/plugin/test/chan/
